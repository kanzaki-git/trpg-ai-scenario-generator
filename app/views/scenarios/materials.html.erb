<div class="container scenario-page">
  <div class="row justify-content-center">
    <div class="col-12 col-xl-10">
      <header class="mb-4">
        <%= render "page_header",
                  eyebrow: @scenario.title,
                  title: "セッション準備資料",
                  description: "登場人物、手がかり、イベントを確認できます。" %>
      </header>

      <%= render "navigation" %>

      <main>
        <section class="mb-5">
          <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <h2 class="h3 fw-bold mb-0">
              登場人物
            </h2>

            <span class="badge text-bg-secondary">
              <%= @scenario_npcs.size %>人
            </span>
          </div>

          <% if @scenario_npcs.any? %>
            <div class="row g-4">
              <% @scenario_npcs.each do |npc| %>
                <div class="col-12">
                  <article class="card shadow-sm h-100">
                    <div class="card-body p-4">
                      <div class="d-flex align-items-start gap-3">
                        <span class="badge rounded-pill text-bg-primary mt-1">
                          <%= npc.position %>
                        </span>

                        <div class="flex-grow-1">
                          <h3 class="h5 fw-bold mb-3">
                            <%= npc.name %>
                          </h3>

                          <div class="lh-lg text-break">
                            <%= simple_format(
                                  npc.description,
                                  class: "mb-0"
                                ) %>
                          </div>

                          <% if npc.initial_location.present? ||
                                npc.initial_activity.present? %>
                            <dl class="border-top pt-3 mt-3 mb-0">
                              <% if npc.initial_location.present? %>
                                <dt class="fw-bold mb-1">
                                  初登場時の居場所
                                </dt>
                                <dd class="mb-3 text-break">
                                  <%= npc.initial_location.name %>
                                </dd>
                              <% end %>

                              <% if npc.initial_activity.present? %>
                                <dt class="fw-bold mb-1">
                                  初登場時の様子
                                </dt>
                                <dd class="mb-0 lh-lg text-break">
                                  <%= simple_format(
                                        npc.initial_activity,
                                        class: "mb-0"
                                      ) %>
                                </dd>
                              <% end %>
                            </dl>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  </article>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="alert alert-secondary">
              登場人物は登録されていません。
            </div>
          <% end %>
        </section>

        <section class="mb-5">
          <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <h2 class="h3 fw-bold mb-0">
              手がかり
            </h2>

            <span class="badge text-bg-secondary">
              <%= @scenario.scenario_clues.count %>個
            </span>
          </div>

          <% if @scenario.scenario_clues.any? %>
            <div class="list-group shadow-sm">
              <% @scenario.scenario_clues.order(:position).each do |clue| %>
                <div class="list-group-item p-4">
                  <div class="d-flex align-items-start gap-3">
                    <span class="badge rounded-pill text-bg-primary mt-1">
                      <%= clue.position %>
                    </span>

                    <div class="flex-grow-1 lh-lg text-break">
                      <%= simple_format(
                            clue.content,
                            class: "mb-0"
                          ) %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="alert alert-secondary">
              手がかりは登録されていません。
            </div>
          <% end %>
        </section>

        <section class="mb-5">
          <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <h2 class="h3 fw-bold mb-0">
              イベント
            </h2>

            <span class="badge text-bg-secondary">
              <%= @scenario.scenario_events.count %>件
            </span>
          </div>

          <% if @scenario.scenario_events.any? %>
            <div class="row g-4">
              <% @scenario.scenario_events.order(:position).each do |event| %>
                <div class="col-12">
                  <article class="card shadow-sm">
                    <div class="card-body p-4">
                      <div class="d-flex align-items-start gap-3">
                        <span class="badge rounded-pill text-bg-primary mt-1">
                          <%= event.position %>
                        </span>

                        <div class="flex-grow-1">
                          <h3 class="h5 fw-bold mb-3">
                            イベント <%= event.position %>
                          </h3>

                          <div class="lh-lg text-break">
                            <%= simple_format(
                                  event.content,
                                  class: "mb-0"
                                ) %>
                          </div>

                          <% if event.trigger_condition.present? %>
                            <div class="alert alert-warning mt-4 mb-0">
                              <h4 class="h6 fw-bold mb-2">
                                発生条件
                              </h4>

                              <div class="lh-lg text-break">
                                <%= simple_format(
                                      event.trigger_condition,
                                      class: "mb-0"
                                    ) %>
                              </div>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  </article>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="alert alert-secondary">
              イベントは登録されていません。
            </div>
          <% end %>
        </section>
      </main>
    </div>
  </div>
</div>
