<% if scene.scenario_locations.any? %>
  <section class="mb-5 scene-locations">
    <h3 class="h5 fw-bold mb-3">
      このシーンで使う場所
    </h3>

    <div class="row g-3">
      <% scene.scenario_locations
              .sort_by { |location| location.position.to_i }
              .each do |location| %>
        <div class="col-12 col-md-6">
          <article class="border rounded-3 p-3 h-100">
            <h4 class="h6 fw-bold mb-2">
              <%= location.name %>
            </h4>

            <div class="lh-lg text-break">
              <%= simple_format(
                    location.description,
                    class: "mb-0"
                  ) %>
            </div>
          </article>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
