<div class="container scenario-page">
  <div class="row justify-content-center">
    <div class="col-12 col-xl-10">
      <header class="mb-4">
        <%= render "page_header",
                  eyebrow: @scenario.title,
                  title: "真相・シナリオ解説",
                  description: "事件の真相と、ゲームマスター向けの解説を確認できます。"
                  %>
      </header>

      <%= render "navigation" %>

      <main>
        <div class="alert alert-danger mb-5" role="alert">
          <h2 class="h5 fw-bold mb-2">
            ネタバレを含みます
          </h2>

          <p class="mb-0">
            この画面はゲームマスター専用です。
            プレイヤーに内容が見えないよう注意してください。
          </p>
        </div>

        <section class="mb-5">
          <h2 class="h3 fw-bold mb-3">
            真相
          </h2>

          <% if @scenario.truth.present? %>
            <details class="card border-danger shadow-sm">
              <summary
                class="card-header bg-danger text-white px-4 py-3 fw-bold"
                style="cursor: pointer;"
              >
                真相を表示する
              </summary>

              <div class="card-body p-4 p-md-5">
                <div class="lh-lg text-break">
                  <%= simple_format(
                        @scenario.truth,
                        class: "mb-0"
                      ) %>
                </div>
              </div>
            </details>
          <% else %>
            <div class="alert alert-secondary">
              真相は登録されていません。
            </div>
          <% end %>
        </section>

        <section class="mb-5 scenario-explanation">
          <h2 class="h3 fw-bold mb-3">
            シナリオ解説
          </h2>

          <p class="text-danger fw-bold mb-3">
            この解説には、事件の真相やエンディングに関する
            ネタバレが含まれています。
          </p>

          <% if @scenario.story_outline.present? %>
            <details class="card border-danger shadow-sm">
              <summary
                class="card-header bg-danger text-white px-4 py-3 fw-bold"
                style="cursor: pointer;"
              >
                シナリオ解説を表示する
              </summary>

              <div class="card-body p-4 p-md-5">
                <div class="lh-lg text-break">
                  <%= simple_format(
                        @scenario.story_outline,
                        class: "mb-0"
                      ) %>
                </div>
              </div>
            </details>
          <% else %>
            <div class="alert alert-secondary">
              シナリオ解説は登録されていません。
            </div>
          <% end %>
        </section>
      </main>
    </div>
  </div>
</div>
