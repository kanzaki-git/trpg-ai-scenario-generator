<div class="container scenario-page">
  <div class="row justify-content-center">
    <div class="col-12 col-xl-10">
      <header class="mb-4">
        <%= render "page_header",
                  eyebrow: @scenario.title,
                  title: "シーン進行",
                  description: "ゲームマスターは、この画面を上から順番に確認しながらセッションを進めてください。" %>

        <div class="d-flex flex-wrap gap-2 mt-3">
          <span class="badge rounded-pill text-bg-secondary px-3 py-2">
            全<%= @scenario_scenes.size %>シーン
          </span>

          <span class="badge rounded-pill text-bg-info px-3 py-2">
            想定時間：
            <%= @scenario_scenes.sum { |scene| scene.estimated_time.to_i } %>分
          </span>
        </div>
      </header>

      <%= render "navigation" %>

      <div class="alert alert-info mb-4">
        <h2 class="h5 fw-bold mb-2">
          この画面を見ながらセッションを進められます
        </h2>

        <p class="mb-0">
          各シーンを上から順番に確認してください。
          読み上げ文章、ゲームマスターが行うこと、
          プレイヤーの行動例、必要な補助情報をまとめています。
        </p>
      </div>

      <% if @scenario.introduction.present? %>
        <section class="mb-5">
          <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <h2 class="h3 fw-bold mb-0">
              セッション開始時の読み上げ
            </h2>

            <span class="badge text-bg-primary">
              最初に読む
            </span>
          </div>

          <div class="card shadow-sm border-primary">
            <div class="card-header fw-bold">
              プレイヤーへそのまま読み上げてください
            </div>

            <div class="card-body p-4">
              <div class="lh-lg text-break">
                <%= simple_format(
                      @scenario.introduction,
                      class: "mb-0"
                    ) %>
              </div>
            </div>
          </div>
        </section>
      <% end %>

      <main>
        <% if @scenario_scenes.any? %>
          <% @scenario_scenes.each_with_index do |scene, scene_index| %>
            <details
              class="card border-0 shadow-sm mb-4"
              <%= "open" if scene_index.zero? %>
            >
              <summary
                class="card-header bg-dark text-white px-4 py-3"
                style="cursor: pointer;"
              >
                <div
                  class="
                    d-flex
                    flex-column
                    flex-md-row
                    justify-content-between
                    align-items-md-center
                    gap-2
                  "
                >
                  <h2 class="h4 fw-bold mb-0">
                    シーン<%= scene.position %>：
                    <%= scene.title %>
                  </h2>

                  <% if scene.estimated_time.present? %>
                    <span class="badge text-bg-light">
                      想定時間：<%= scene.estimated_time %>分
                    </span>
                  <% end %>
                </div>
              </summary>

              <div class="card-body p-4 p-md-5">
                <%= render "scene_locations", scene: scene %>

                <% if scene.purpose.present? %>
                  <section class="mb-5">
                    <h3 class="h5 fw-bold mb-3">
                      シーンの目的
                    </h3>

                    <div class="alert alert-primary mb-0">
                      <div class="lh-lg text-break">
                        <%= simple_format(
                              scene.purpose,
                              class: "mb-0"
                            ) %>
                      </div>
                    </div>
                  </section>
                <% end %>

                <% if scene.trigger_condition.present? %>
                  <section class="mb-5">
                    <h3 class="h5 fw-bold mb-3">
                      シーンの開始条件
                    </h3>

                    <div class="border rounded-3 p-4">
                      <div class="lh-lg text-break">
                        <%= simple_format(
                              scene.trigger_condition,
                              class: "mb-0"
                            ) %>
                      </div>
                    </div>
                  </section>
                <% end %>

                <% if scene.read_aloud_text.present? %>
                  <section class="mb-5">
                    <div
                      class="
                        d-flex
                        flex-wrap
                        align-items-center
                        gap-2
                        mb-3
                      "
                    >
                      <h3 class="h5 fw-bold mb-0">
                        ゲームマスターが読み上げる文章
                      </h3>

                      <span class="badge text-bg-primary">
                        そのまま読み上げ可能
                      </span>
                    </div>

                    <div class="card bg-body-tertiary border-0">
                      <div class="card-body p-4">
                        <div
                          class="
                            border-start
                            border-4
                            border-primary
                            ps-4
                            lh-lg
                            text-break
                          "
                        >
                          <%= simple_format(
                                scene.read_aloud_text,
                                class: "mb-0"
                              ) %>
                        </div>
                      </div>
                    </div>
                  </section>
                <% end %>

                <% if scene.gm_actions.present? %>
                  <section class="mb-5">
                    <h3 class="h5 fw-bold mb-3">
                      ゲームマスターが行うこと
                    </h3>

                    <div class="border rounded-3 p-4">
                      <div class="lh-lg text-break">
                        <%= simple_format(
                              scene.gm_actions,
                              class: "mb-0"
                            ) %>
                      </div>
                    </div>
                  </section>
                <% end %>

                <%= render "scene_exploration_cues", scene: scene %>

                <%= render "scene_choices", scene: scene %>

                <%= render "scene_support_information", scene: scene %>

                <% if scene.hint.present? %>
                  <section class="mb-5">
                    <details class="border rounded-3">
                      <summary
                        class="fw-bold p-3"
                        style="cursor: pointer;"
                      >
                        進行が止まった場合のヒント
                      </summary>

                      <div class="border-top p-4">
                        <div class="alert alert-warning mb-0">
                          <div class="lh-lg text-break">
                            <%= simple_format(
                                  scene.hint,
                                  class: "mb-0"
                                ) %>
                          </div>
                        </div>
                      </div>
                    </details>
                  </section>
                <% end %>

                <% if scene.transition_condition.present? %>
                  <section>
                    <h3 class="h5 fw-bold mb-3">
                      次のシーンへ進む条件
                    </h3>

                    <div class="alert alert-success mb-0">
                      <div class="lh-lg text-break">
                        <%= simple_format(
                              scene.transition_condition,
                              class: "mb-0"
                            ) %>
                      </div>
                    </div>
                  </section>
                <% end %>
              </div>
            </details>
          <% end %>
        <% else %>
          <div class="alert alert-secondary">
            シーンは登録されていません。
          </div>
        <% end %>
      </main>
    </div>
  </div>
</div>
