<% if scene.player_questions.present? ||
      scene.scenario_scene_npcs.any? ||
      scene.scenario_clues.any? %>
  <section class="mb-5">
    <h3 class="h5 fw-bold mb-2">
      このシーンの補助情報
    </h3>

    <p class="text-body-secondary mb-4">
      プレイヤーの行動や質問に応じて、
      必要な項目だけ開いて確認してください。
    </p>

    <% if scene.scenario_scene_npcs.any? %>
      <details class="border rounded-3 mb-3">
        <summary
          class="fw-bold p-3"
          style="cursor: pointer;"
        >
          このシーンに関わる人物
          （<%= scene.scenario_scene_npcs.size %>人）
        </summary>

        <div class="border-top p-4">
          <% scene.scenario_scene_npcs
                  .sort_by { |scene_npc| scene_npc.scenario_npc.position.to_i }
                  .each do |scene_npc| %>
            <% npc = scene_npc.scenario_npc %>
            <% location = scene_npc.scenario_location || npc.initial_location %>

            <article class="mb-4">
              <div class="d-flex align-items-center gap-2 mb-3">
                <h4 class="h6 fw-bold mb-0">
                  <%= npc.name %>
                </h4>

                <span class="badge text-bg-secondary">
                  <%= scene_npc.remote? ? "遠隔" : "対面" %>
                </span>
              </div>

              <dl class="mb-3">
                <% if location.present? %>
                  <dt class="fw-bold mb-1">
                    <%= scene_npc.remote? ? "実際の居場所" : "居場所" %>
                  </dt>
                  <dd class="mb-3 text-break">
                    <%= location.name %>
                  </dd>
                <% end %>

                <% if scene_npc.activity.present? %>
                  <dt class="fw-bold mb-1">
                    <%= scene_npc.remote? ? "別の場所での様子" : "この場面での様子" %>
                  </dt>
                  <dd class="mb-3 lh-lg text-break">
                    <%= simple_format(
                          scene_npc.activity,
                          class: "mb-0"
                        ) %>
                  </dd>
                <% end %>

                <% if scene_npc.appearance_condition.present? %>
                  <dt class="fw-bold mb-1">
                    <%= scene_npc.remote? ? "参加・登場のタイミング" : "登場・移動のタイミング" %>
                  </dt>
                  <dd class="mb-0 lh-lg text-break">
                    <%= simple_format(
                          scene_npc.appearance_condition,
                          class: "mb-0"
                        ) %>
                  </dd>
                <% end %>
              </dl>

              <% if scene_npc.reaction.present? %>
                <div class="bg-body-tertiary rounded-3 p-3">
                  <h5 class="h6 fw-bold mb-2">
                    人物の反応・ゲームマスター向けメモ
                  </h5>

                  <div class="lh-lg text-break">
                    <%= simple_format(
                          scene_npc.reaction,
                          class: "mb-0"
                        ) %>
                  </div>
                </div>
              <% end %>
            </article>
          <% end %>
        </div>
      </details>
    <% end %>

    <% if scene.scenario_clues.any? %>
      <details class="border rounded-3 mb-3">
        <summary
          class="fw-bold p-3"
          style="cursor: pointer;"
        >
          このシーンで入手できる手がかり
          （<%= scene.scenario_clues.size %>件）
        </summary>

        <div class="border-top p-4">
          <% scene.scenario_clues
                  .sort_by { |clue| clue.position.to_i }
                  .each do |clue| %>
            <div class="alert alert-primary mb-3">
              <%= simple_format(
                    clue.content,
                    class: "mb-0"
                  ) %>
            </div>
          <% end %>
        </div>
      </details>
    <% end %>

    <% if scene.player_questions.present? %>
      <details class="border rounded-3">
        <summary
          class="fw-bold p-3"
          style="cursor: pointer;"
        >
          プレイヤーからの想定質問と回答例
        </summary>

        <div class="border-top p-4">
          <div class="lh-lg text-break">
            <%= simple_format(
                  scene.player_questions,
                  class: "mb-0"
                ) %>
          </div>
        </div>
      </details>
    <% end %>
  </section>
<% end %>
