<% if flash.any? %>
  <div class="container mt-3">
    <% flash.each do |type, message| %>
      <% bootstrap_class = {
        "notice" => "success",
        "alert" => "danger",
        "success" => "success",
        "danger" => "danger"
      }.fetch(type.to_s, "info") %>

      <div class="alert alert-<%= bootstrap_class %>" role="alert">
        <%= message %>
      </div>
    <% end %>
  </div>
<% end %>
